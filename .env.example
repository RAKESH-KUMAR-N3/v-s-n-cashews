# ===================================================
# V S N CASHEWS - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# 1. Database Configuration (MongoDB Atlas Connection String for Prisma ORM)
# Example: mongodb+srv://vsn_user:password@cluster0.mongodb.net/vsn_cashews?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/vsn_cashews?retryWrites=true&w=majority"

# 2. Next Auth / Better Auth Secret & App URL
BETTER_AUTH_SECRET="vsn_cashews_royal_secret_32_chars_minimum_length_key_2026"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="V S N CASHEWS"

# 3. Razorpay Payment Gateway Credentials (India INR)
RAZORPAY_KEY_ID="rzp_test_vsn_cashews_key"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_vsn_cashews_key"

# 4. Cloudinary Image Storage Credentials
CLOUDINARY_CLOUD_NAME="vsn-cashews"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="vsn-cashews"

# 5. Admin Order Notifications & Email (Nodemailer / Resend / SMTP)
ADMIN_EMAIL="orders@vsncashews.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@vsncashews.com"
SMTP_PASS="your_smtp_app_password"
