# ==========================================
# V S N CASHEWS - ENVIRONMENT CONFIGURATION
# ==========================================

# Database Configuration (MongoDB Atlas Connection String)
# Replace with your MongoDB Atlas Connection String
# Example: mongodb+srv://username:password@cluster0.mongodb.net/vsn_cashews?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/vsn_cashews?retryWrites=true&w=majority"

# Better Auth Configuration
BETTER_AUTH_SECRET="vsn_cashews_royal_secret_32_chars_minimum_length_key"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudinary Credentials (For Product Images & Gift Box Banners)
CLOUDINARY_CLOUD_NAME="vsn-cashews"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"
VITE_CLOUDINARY_CLOUD_NAME="vsn-cashews"

# Razorpay Payment Gateway Keys
RAZORPAY_KEY_ID="rzp_test_vsn_cashews_key"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key_here"
VITE_RAZORPAY_KEY_ID="rzp_test_vsn_cashews_key"

# App & Site Metadata
VITE_APP_NAME="V S N CASHEWS"
VITE_APP_URL="http://localhost:3000"
VITE_CURRENCY_SYMBOL="₹"
VITE_CURRENCY_CODE="INR"

# Admin Notifications & Email (Nodemailer / Resend)
ADMIN_EMAIL="orders@vsncashews.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@vsncashews.com"
SMTP_PASS="your_smtp_password"
